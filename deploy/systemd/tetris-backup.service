# 定时备份 tetris.db（由 tetris-backup.timer 触发，见同目录）
#
# 走 tetris-admin backup（SQLite Online Backup API），服务端不用停、WAL 下也一致；
# 备份里是密码哈希，所以落盘即 chmod 600，目录本身 0700（install-systemd.sh 建的）。
#
# 手动跑一次：sudo systemctl start tetris-backup.service
# 看结果：    systemctl status tetris-backup.service / journalctl -u tetris-backup
[Unit]
Description=Snapshot tetris.db with tetris-admin backup
Documentation=file:///usr/local/share/doc/tetris/DEPLOY.md
After=tetris-game.service

[Service]
Type=oneshot
User=tetrisd
Group=tetrisd

Environment=TETRIS_DB=/var/lib/tetris/tetris.db
Environment=TETRIS_ADMIN=/usr/local/bin/tetris-admin
Environment=TETRIS_BACKUP_DIR=/var/backups/tetris
# 保留最近多少份（1 份 ≈ 库大小）；按天备份，14 份 ≈ 两周
Environment=TETRIS_BACKUP_KEEP=14

ExecStart=/usr/local/bin/tetris-backup

# 备份目录不在 StateDirectory 里，必须显式放行（ProtectSystem=strict 默认只读）
ReadWritePaths=/var/backups/tetris
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
Nice=10
IOSchedulingClass=idle
